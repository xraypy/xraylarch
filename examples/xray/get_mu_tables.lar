# example getting tabulated mu values from mu_elam
from numpy import linspace, log
from xraydb import mu_elam, atomic_symbol
from wxmplot.interactive import plot
e = linspace(0, 20000, 401)
z1, z2, z3 = 12, 20, 38
# z1, z2, z3 = 16, 34, 82

mu1 = mu_elam(z1, e)
mu2 = mu_elam(z2, e)
mu3 = mu_elam(z3, e)

plot(e, log(mu1), xlabel='E (eV)', label=atomic_symbol(z1),
        show_legend=True,
        ylabel=r'$ \ln(\mu/\rho) \rm\, (cm^2/g) $ ',
        title='Mass attenuation coefficient', new=True)

plot(e, log(mu2), label=atomic_symbol(z2))
plot(e, log(mu3), label=atomic_symbol(z3))
